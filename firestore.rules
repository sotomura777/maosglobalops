rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Perfis: cada pessoa cria e edita o SEU; leitura pública virá com o
    // diretório (F1) — por agora só o próprio lê (privacidade por defeito).
    match /profiles/{uid} {
      allow read, update: if isSelf(uid);
      allow create: if isSelf(uid) &&
        request.resource.data.get('kind', '') in ['worker'] &&
        request.resource.data.keys().hasOnly(['kind', 'name', 'email', 'createdAt', 'gdprConsent']) &&
        request.resource.data.gdprConsent == true;
    }
  }
}
