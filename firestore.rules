rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function verified() { return signed() && request.auth.token.get('email_verified', false) == true; }
    function self(uid) { return signed() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function kind(k) { return signed() && profile().kind == k; }
    function shortText(v, n) { return v is string && v.size() <= n; }
    function participant(a) { return signed() && (a.workerId == request.auth.uid || a.companyId == request.auth.uid); }
    function job(id) { return get(/databases/$(database)/documents/jobs/$(id)).data; }
    function engagement(id) { return get(/databases/$(database)/documents/engagements/$(id)).data; }
    function profileEdit() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        shortText(d.get('headline', ''),160) && shortText(d.get('bio',''),2500) &&
        shortText(d.get('phone',''),30) && shortText(d.get('district',''),100) &&
        shortText(d.get('languages',''),100) && shortText(d.get('companyLegalName',''),200) &&
        shortText(d.get('website',''),500) && d.get('public',false) is bool &&
        d.get('categories',[]) is list && d.get('categories',[]).size() <= 12 &&
        d.get('prefs',[]) is list && d.get('prefs',[]).size() <= 4 &&
        d.get('experience',[]) is list && d.get('experience',[]).size() <= 50 &&
        d.get('availability','disponivel') in ['disponivel','limitada','indisponivel'];
    }
    match /profiles/{uid} {
      allow read: if self(uid);
      allow create: if self(uid) && request.resource.data.keys().hasOnly(['kind','name','email','createdAt','gdprConsent']) &&
        request.resource.data.kind in ['worker','company'] && request.resource.data.gdprConsent == true &&
        request.resource.data.email == request.auth.token.email && profileEdit();
      allow update: if self(uid) && profileEdit() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name','headline','bio','district','phone','languages','categories','prefs','availability','public','experience','companyLegalName','website','updatedAt','importExperience'
      ]) && request.resource.data.get('importExperience',false) is bool &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['public']) ||
          getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data.public == request.resource.data.public);
      match /worklog/{entryId} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid) && request.resource.data.keys().hasOnly(['date','hours','rate','company','createdAt']) &&
          request.resource.data.hours is number && request.resource.data.hours > 0 && request.resource.data.hours <= 24 &&
          request.resource.data.rate is number && request.resource.data.rate >= 0 && request.resource.data.rate <= 100000 &&
          request.resource.data.date is string;
      }
      match /jobDrafts/{draftId} {
        allow read, delete: if self(uid) && kind('company');
        allow create, update: if self(uid) && kind('company') && request.resource.data.keys().hasOnly(['form','updatedAt']) && request.resource.data.updatedAt == request.time && request.resource.data.form is map && request.resource.data.form.keys().hasOnly(['title','category','district','location','date','startTime','endTime','vacancies','rate','payType','paymentTerms','description','transport','meal','equipment']) && shortText(request.resource.data.form.get('title',''),120) && shortText(request.resource.data.form.get('description',''),5000);
      }
      match /savedJobs/{jobId} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid) && request.resource.data.keys().hasOnly(['savedAt']) && request.resource.data.savedAt == request.time;
      }
      match /readEvents/{eventId} {
        allow read: if self(uid);
        allow create, update: if self(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      }
      // Trabalhos anteriores declarados pelo trabalhador. 'verified' e 'rejected' só o servidor os põe.
      // Sem update: um pedido enviado não muda enquanto a empresa o avalia; corrigir é apagar e declarar de novo.
      match /historyClaims/{claimId} {
        allow read: if self(uid) || (signed() && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.public == true);
        allow create: if self(uid) && kind('worker') &&
          request.resource.data.keys().hasOnly(['title','companyName','companyId','date','hours','description','status','createdAt']) &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 &&
          request.resource.data.companyName is string && request.resource.data.companyName.size() > 0 && request.resource.data.companyName.size() <= 200 &&
          request.resource.data.status in ['self_declared','pending'] &&
          shortText(request.resource.data.get('companyId',''),200) &&
          shortText(request.resource.data.get('description',''),500) &&
          request.resource.data.get('date','').matches('^([0-9]{4}-[0-9]{2}(-[0-9]{2})?)?$') &&
          request.resource.data.get('hours',0) is number &&
          request.resource.data.get('hours',0) >= 0 && request.resource.data.get('hours',0) <= 5000;
        allow delete: if self(uid) && resource.data.status != 'verified';
      }
    }
    // Consulta em grupo: a empresa vê apenas os pedidos de confirmação que lhe são dirigidos.
    match /{path=**}/historyClaims/{claimId} {
      allow read: if signed() && resource.data.companyId == request.auth.uid && resource.data.status == 'pending';
    }
    match /publicProfiles/{uid} {
      allow read: if self(uid) || (signed() && resource.data.public == true);
      allow create, update: if self(uid) && profileEdit() &&
        request.resource.data.keys().hasOnly(['kind','name','public','headline','bio','district','languages','companyLegalName','website','availability','categories','prefs','experience']) &&
        request.resource.data.kind == getAfter(/databases/$(database)/documents/profiles/$(uid)).data.kind &&
        request.resource.data.public == getAfter(/databases/$(database)/documents/profiles/$(uid)).data.get('public',false);
    }
    // Importações oficiais continuam a ser escritas exclusivamente pelo Admin SDK.
    // A reputação nova é criada por avaliações de contratações concluídas.
    match /validations/{id} { allow read: if self(resource.data.workerId) || (signed() && get(/databases/$(database)/documents/publicProfiles/$(resource.data.workerId)).data.public == true); }
    // Contadores de fiabilidade (faltas, atrasos, cancelamentos, concluídos). Só o servidor escreve.
    match /reputations/{uid} { allow read: if self(uid) || (signed() && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.public == true); }
    // Validação das empresas pela administração. Só o servidor escreve.
    match /companyStatus/{uid} { allow read: if signed(); }
    // Histórico de trabalhos verificados. Escrito só pelo servidor ao concluir ou ao aprovar.
    match /workHistory/{id} { allow read: if self(resource.data.workerId) || (signed() && get(/databases/$(database)/documents/publicProfiles/$(resource.data.workerId)).data.public == true); }
    match /channels/{channelId} {
      allow read: if signed();
      // Canais de tema: nomes fixos, criados uma vez e nunca renomeados.
      allow create: if signed() && request.resource.data.keys().hasOnly(['type','name','createdAt']) &&
        request.resource.data.type == 'topic' && request.resource.data.createdAt == request.time &&
        {'t-geral':'# geral','t-porto':'# porto','t-lisboa':'# lisboa','t-bar-e-mesa':'# bar e mesa',
         't-montagens':'# montagens','t-ultima-hora':'# última hora'}.get(channelId, null) == request.resource.data.name;
      allow create, update: if signed() && (
        (kind('company') && channelId == 'c-' + request.auth.uid && request.resource.data.type == 'company' &&
          request.resource.data.companyId == request.auth.uid && request.resource.data.name == profile().name &&
          request.resource.data.keys().hasOnly(['type','name','createdAt','companyId','brandColor']))
      );
      match /posts/{postId} {
        allow read: if signed();
        allow create: if verified() && request.resource.data.keys().hasOnly(['authorId','authorName','authorKind','text','createdAt']) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.authorId == request.auth.uid && request.resource.data.authorName == profile().name &&
          request.resource.data.authorKind == profile().kind && shortText(request.resource.data.text,2000) && request.resource.data.text.size() > 0 && (
          get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'topic' ||
          get(/databases/$(database)/documents/channels/$(channelId)).data.companyId == request.auth.uid);
        allow delete: if signed() && resource.data.authorId == request.auth.uid;
      }
    }
    match /jobs/{jobId} {
      allow read: if signed();
      allow create: if false; // Publicação validada pela função contracting.
      // Condições da oferta ficam estáveis depois de publicadas.
      allow update: if signed() && resource.data.companyId == request.auth.uid && resource.data.status == 'open' &&
        request.resource.data.status == 'closed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Preservar a leitura das candidaturas da primeira versão.
      match /applications/{workerUid} {
        allow read: if self(workerUid) || (signed() && job(jobId).companyId == request.auth.uid);
        allow delete: if self(workerUid);
      }
    }
    match /engagements/{id} {
      allow get: if signed() && !exists(/databases/$(database)/documents/engagements/$(id)) && id.matches('.*_' + request.auth.uid);
      allow read: if participant(resource.data);
      allow create: if false;
      // Estado, agenda, vagas e condições aceites são escritos apenas no servidor.
      allow update: if participant(resource.data) && request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageBy','lastMessageAt','updatedAt','lastMessageText']) &&
        request.resource.data.lastMessageBy == request.auth.uid && request.resource.data.lastMessageAt == request.time &&
        shortText(request.resource.data.get('lastMessageText',''),160);
      match /events/{eventId} { allow read: if participant(engagement(id)); }
      match /messages/{messageId} {
        allow read: if participant(engagement(id));
        allow create: if participant(engagement(id)) && request.resource.data.keys().hasOnly(['senderId','text','createdAt']) &&
          request.resource.data.senderId == request.auth.uid && shortText(request.resource.data.text,2000) &&
          request.resource.data.text.size() > 0 && request.resource.data.createdAt == request.time;
      }
    }
    match /reviews/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['engagementId','authorId','subjectId','rating','text','createdAt']) &&
        participant(engagement(request.resource.data.engagementId)) && engagement(request.resource.data.engagementId).status == 'completed' &&
        request.resource.data.authorId == request.auth.uid && id == request.resource.data.engagementId + '_' + request.auth.uid &&
        request.resource.data.subjectId == (request.auth.uid == engagement(request.resource.data.engagementId).companyId ?
          engagement(request.resource.data.engagementId).workerId : engagement(request.resource.data.engagementId).companyId) &&
        request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        shortText(request.resource.data.text,1500) && request.resource.data.createdAt == request.time;
    }
  }
}
